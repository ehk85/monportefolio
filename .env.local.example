# Copie ce fichier en .env.local (ignoré par git) et remplis les valeurs.
# Pour la production, ajoute les mêmes variables dans Vercel :
# Project Settings > Environment Variables.

# Supabase (Project Settings > API dans ton projet Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Accès à /admin (choisis tes propres identifiants)
ADMIN_USER=
ADMIN_PASSWORD=

# Resend (resend.com) — envoie un email à chaque nouvel avis déposé.
# Clé API dans resend.com > API Keys. "to" = ton adresse profile.ts (déjà fixée dans le code).
RESEND_API_KEY=

# URL publique de ton site, pour que l'email de notification pointe vers /admin
# (ex: https://monportefolio.vercel.app). Optionnel : sans elle, l'email dit juste "va sur /admin".
NEXT_PUBLIC_SITE_URL=
